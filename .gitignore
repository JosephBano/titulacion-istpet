# =============================================================================
#  SECRETOS Y CONFIGURACION DE ENTORNO  --  LEER ANTES DE TOCAR
# =============================================================================
# Este repositorio es PUBLICO. Nada de lo que aparece en este bloque debe llegar
# nunca a un commit. Para cada archivo ignorado existe un *.example.* versionado
# que documenta la forma sin exponer los valores.
#
#   backend/src/Titan.Api/appsettings.example.json               -> appsettings.json
#   frontend/src/environments/environment.example.ts              -> environment.prod.ts

# --- Backend: appsettings reales (base, por entorno y locales) ---
appsettings.json
appsettings.*.json
!appsettings.example.json
!appsettings.Example.json
!appsettings.json.template

# --- Backend: user secrets y certificados de desarrollo ---
secrets.json
secrets.Development.json
usersecrets/
*.pfx
*.p12
*.snk

# --- Frontend: environments con endpoints/valores reales ---
frontend/src/environments/environment.prod.ts
frontend/src/environments/environment.*.local.ts
!frontend/src/environments/environment.ts
!frontend/src/environments/environment.example.ts

# --- Variables de entorno ---
.env
.env.*
!.env.example
!.env.template

# --- Llaves y certificados de cualquier tipo ---
*.pem
*.key
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*

