{
  "//": "Plantilla. Copiala a appsettings.json y appsettings.Development.json (ambas git-ignored) y rellena los valores reales. NUNCA subas credenciales a este repositorio.",

  "ConnectionStrings": {
    "MySqlLegacy": "Server=localhost;Port=3306;Database=titulacion_istpet;User Id=YOUR_USER;Password=YOUR_PASSWORD_HERE;SslMode=Preferred;CharSet=utf8mb4;TreatTinyAsBoolean=true"
  },

  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:4200" ]
  },

  "Jwt": {
    "Issuer": "https://localhost:7077",
    "Audience": "titulacion-istpet-frontend",
    "ClaveFirma": "CAMBIAME-minimo-32-caracteres-aleatorios",
    "MinutosExpiracion": 60
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "AllowedHosts": "*"
}
